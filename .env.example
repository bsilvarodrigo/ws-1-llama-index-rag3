# LLM
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL (Ledger)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dataops
POSTGRES_USER=dataops
POSTGRES_PASSWORD=dataops123

# MongoDB (Events)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=dataops

# Qdrant (Memory)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=dataops-memory

# Neo4j (Brain)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dataops123

# SeaweedFS (Data Lake)
SEAWEEDFS_HOST=localhost
SEAWEEDFS_PORT=8333
SEAWEEDFS_BUCKET=dataops-lake
# SeaweedFS runs without S3 auth in dev, but boto3 and the aws CLI still require credentials to be set
AWS_ACCESS_KEY_ID=dataops
AWS_SECRET_ACCESS_KEY=dataops123

# Data Generator
GENERATOR_INTERVAL_SECONDS=30

# MCP Server
API_BASE_URL=http://localhost:8000
